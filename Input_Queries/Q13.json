{
  "id": "twoArraydimensionGroupOr",
  "name": "Query with a dimension, an array and another array dimension from another group, filtered by a OR on both group based array the array",
  "metrics": [
    { "alias": "sum_mtm", "expression": "sum(mtm)" }
  ],
  "groupBy": ["book", "legalEntity", "legType"],
  "filter": {
    "op": "or",
    "operands": [
      { "op": "in", "dimension": "csaId", "values": ["csa1"] },
      { "op": "in", "dimension": "legType", "values": ["put"] },
      { "op": "in", "dimension": "legalEntity", "values": ["FR"] }
    ]
  }
}
